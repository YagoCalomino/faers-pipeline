# Copy to .env (`make env` does it) and adjust. Never commit .env.

# Lets `docker compose ...` work from the repo root.
COMPOSE_FILE=infra/docker/docker-compose.yml
COMPOSE_PROJECT_NAME=faers-pipeline

# Linux: set to the output of `id -u`. Windows/macOS: 50000 is fine.
AIRFLOW_UID=50000

# Initial admin user, created by airflow-init (FAB auth manager).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Encrypts connections/variables in the metadata DB. Generate with `make fernet`.
FERNET_KEY=

# Shared by api-server, scheduler and dag-processor. Use any long random string.
AIRFLOW__API_AUTH__JWT_SECRET=change-me-to-a-long-random-string
