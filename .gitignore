# Data and runtime output (keep only the .gitkeep placeholders)
data/**
!data/**/
!data/**/.gitkeep
logs/

# Secrets
.env

# Build / tool output
target/
dbt_packages/
node_modules/
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Airflow may write a default config if AIRFLOW_CONFIG ever points here
config/airflow.cfg

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# dbt anonymous usage id (written by dbt on first run)
.user.yml

# Site build and local tooling (site/)
site/dist/
site/dist-*/
site/.npm-cache/
site/.pw-browsers/
site/test-output/

# Local assistant notes (kept on disk, not versioned)
CLAUDE.md
